# Copy this file to `.env` and fill in real values, OR set these as environment
# variables in your host (e.g. Vercel → Project → Settings → Environment Variables).
# This template is safe to commit; the real `.env` is git-ignored and must NOT be.
#
# The backend (/api functions + server.js) reads these. The KEY_SECRET never
# reaches the browser — the front-end only gets the publishable key_id.

# Active key set: "live" (REAL money) or "test" (sandbox).
RAZORPAY_MODE=live

# Test keys (Razorpay Dashboard → Test Mode → Settings → API Keys)
RAZORPAY_TEST_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_TEST_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# Live keys (Razorpay Dashboard → Live Mode → Settings → API Keys)
RAZORPAY_LIVE_KEY_ID=rzp_live_xxxxxxxxxxxxxx
RAZORPAY_LIVE_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# --- Shopify ---
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com

# CLIENT_ID/SECRET are needed ONLY for the one-time OAuth handshake
# (/api/shopify/install → /api/shopify/callback). After you obtain the
# permanent token below, they can be removed from the runtime env.
SHOPIFY_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SHOPIFY_CLIENT_SECRET=shpss_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Optional: force the exact callback URL registered in the Shopify Dev Dashboard.
# Defaults to https://<request-host>/api/shopify/callback if unset.
# SHOPIFY_REDIRECT_URI=https://your-domain.com/api/shopify/callback

# The permanent Admin API token produced by the handshake — paste it here (and
# in Vercel). This is what ongoing runtime functions read directly.
SHOPIFY_ADMIN_API_ACCESS_TOKEN=shpat_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
