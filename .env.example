# Copy this file to `.env` and fill in real values, OR set these as environment
# variables in your host (e.g. Vercel → Project → Settings → Environment Variables).
# This template is safe to commit; the real `.env` is git-ignored and must NOT be.
#
# The backend (/api functions + server.js) reads these. The KEY_SECRET never
# reaches the browser — the front-end only gets the publishable key_id.

# Active key set: "test" (sandbox, no real money) or "live" (REAL money).
RAZORPAY_MODE=test

# Test keys (Razorpay Dashboard → Test Mode → Settings → API Keys)
RAZORPAY_TEST_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_TEST_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# Live keys (Razorpay Dashboard → Live Mode → Settings → API Keys)
RAZORPAY_LIVE_KEY_ID=rzp_live_xxxxxxxxxxxxxx
RAZORPAY_LIVE_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
